# Humanoid — persistent name for the external WitMotion USB IMU.
#
# The IMU is a 10-axis AHRS on a CH340 USB-serial bridge (idVendor 1a86, idProduct 7523).
# Unlike the CAN adapters, the CH340 exposes NO unique serial number, so we match on
# vendor:product. This is unambiguous as long as there is exactly ONE CH340 on the bus —
# the leg CAN adapters use a different chip (Geschwister Schneider gs_usb, net devices, not
# tty). If you ever add a second CH340 device, disambiguate by USB port (KERNELS==) instead.
#
# Creates /dev/humanoid_imu → the raw /dev/ttyUSBx, world-accessible so the daemon
# (User=nse, not in `dialout`) can open it without a group-membership dependency.
#
# Install:
#   sudo cp /home/nse/humanoid-control/deploy/99-humanoid-imu.rules /etc/udev/rules.d/
#   sudo udevadm control --reload-rules && sudo udevadm trigger
# Verify:
#   ls -l /dev/humanoid_imu     # → symlink to ttyUSBx

SUBSYSTEM=="tty", ACTION=="add", ATTRS{idVendor}=="1a86", ATTRS{idProduct}=="7523", SYMLINK+="humanoid_imu", MODE="0666"
